@startuml

package "dominio" {
    abstract class Funcion {
        # codigo : int
        # nombre : String
        # duracion : int
        # precio : double
        # horario : String
        # sala : Sala
        + Funcion(codigo: int, nombre: String, duracion: int, precio: double, horario: String)
        + {abstract} calcularPrecioConDescuento() : double
        + {abstract} getTipo() : String
        + {abstract} getDetallesEspecificos() : String
        + getCodigo() : int
        + getNombre() : String
        + getDuracion() : int
        + getPrecio() : double
        + getHorario() : String
        + getSala() : Sala
    }

    class Pelicula extends Funcion {
        - genero : String
        - nominadaOscar : boolean
        + Pelicula(codigo: int, nombre: String, duracion: int, precio: double, horario: String, genero: String, nominadaOscar: boolean)
        + calcularPrecioConDescuento() : double
        + getTipo() : String
        + getDetallesEspecificos() : String
    }

    class ObraTeatro extends Funcion {
        - autor : String
        - cantidadActos : int
        + ObraTeatro(codigo: int, nombre: String, duracion: int, precio: double, horario: String, autor: String, cantidadActos: int)
        + calcularPrecioConDescuento() : double
        + getTipo() : String
        + getDetallesEspecificos() : String
    }

    class Documental extends Funcion {
        - tema : String
        - anioProduccion : int
        + Documental(codigo: int, nombre: String, duracion: int, precio: double, horario: String, tema: String, anioProduccion: int)
        + calcularPrecioConDescuento() : double
        + getTipo() : String
        + getDetallesEspecificos() : String
    }

    class Sala {
        - asientos : boolean[][]
        - capacidadMaxima : int
        - asientosOcupados : int
        + Sala()
        + estaDisponible(numeroAsiento: int) : boolean
        + ocuparAsiento(numeroAsiento: int) : boolean
        + obtenerMapaAsientos() : String
        + getAsientosDisponibles() : int
        + getAsientosOcupados() : int
        + getCapacidadMaxima() : int
    }

    class Usuario {
        - nombre : String
        - rut : String
        - contrasena : String
        - miembroClub : boolean
        + Usuario(nombre: String, rut: String, contrasena: String)
        + getNombre() : String
        + getRut() : String
        + getContrasena() : String
        + isMiembroClub() : boolean
        + setMiembroClub(miembroClub: boolean) : void
    }

    Funcion *-- "1" Sala : posee >
}

package "servicios" {
    interface SistemaTeatro {
        + cargarFunciones(rutaArchivo: String) : void
        + registrarUsuario(nombre: String, rut: String, contrasena: String) : boolean
        + iniciarSesion(rut: String, contrasena: String) : Usuario
        + cerrarSesion() : void
        + unirseAlClub(rut: String, contrasena: String) : boolean
        + obtenerFuncionesDisponibles() : List<Funcion>
        + buscarPorCodigo(codigo: int) : Funcion
        + buscarPorNombre(nombre: String) : List<Funcion>
        + buscarPorHorario(horario: String) : List<Funcion>
        + comprarEntradas(funcion: Funcion, asientos: int[]) : String
        + generarArchivoEstadisticas(rutaSalida: String) : void
        + getUsuarioActual() : Usuario
    }

    class SistemaTeatroImpl implements SistemaTeatro {
        - funciones : List<Funcion>
        - usuarios : List<Usuario>
        - usuarioActual : Usuario
        - recaudacionNoche : double
        - gananciasTotales : double
        + SistemaTeatroImpl()
        + cargarFunciones(rutaArchivo: String) : void
        + registrarUsuario(nombre: String, rut: String, contrasena: String) : boolean
        + iniciarSesion(rut: String, contrasena: String) : Usuario
        + cerrarSesion() : void
        + unirseAlClub(rut: String, contrasena: String) : boolean
        + obtenerFuncionesDisponibles() : List<Funcion>
        + buscarPorCodigo(codigo: int) : Funcion
        + buscarPorNombre(nombre: String) : List<Funcion>
        + buscarPorHorario(horario: String) : List<Funcion>
        + comprarEntradas(funcion: Funcion, asientos: int[]) : String
        + generarArchivoEstadisticas(rutaSalida: String) : void
        + getUsuarioActual() : Usuario
    }

    SistemaTeatroImpl o-- "*" Funcion : gestiona >
    SistemaTeatroImpl o-- "*" Usuario : registra >
}

package "vista" {
    class Main {
        + {static} main(args: String[]) : void
        - {static} mostrarMenuInicial() : void
        - {static} procesarRegistro(sistema: SistemaTeatro, sc: Scanner) : void
        - {static} procesarInicioSesion(sistema: SistemaTeatro, sc: Scanner) : boolean
        - {static} ejecutarMenuPrincipal(sistema: SistemaTeatro, sc: Scanner) : void
        - {static} procesarCompra(sistema: SistemaTeatro, sc: Scanner) : void
        - {static} mostrarFuncionesDisponibles(sistema: SistemaTeatro) : void
        - {static} procesarBusqueda(sistema: SistemaTeatro, sc: Scanner) : void
        - {static} imprimirDetalleBusqueda(f: Funcion) : void
        - {static} leerEntero(sc: Scanner) : int
    }

    Main ..> SistemaTeatro : utiliza >
}
@enduml
